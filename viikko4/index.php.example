
<?php
$mysqli = new mysqli(
    "localhost",
    "counter_reader",
    "SALASANA",
    "visitors"
);

if ($mysqli->connect_error) {
    http_response_code(500);
    die("Database connection failed.");
}

$result = $mysqli->query("SELECT hits FROM counter WHERE id = 1");

if (!$result) {
    die("Could not read visitor counter.");
}

$row = $result->fetch_assoc();
?>

